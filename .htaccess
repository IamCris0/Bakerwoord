# =============================================================================
# Mawëwë — configuración Apache
# =============================================================================

# --- Codificación ------------------------------------------------------------
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .json .xml .svg
</IfModule>

# --- Página de error ---------------------------------------------------------
ErrorDocument 404 /404.html

# --- Redirecciones del sitio anterior ---------------------------------------
# Mantienen el posicionamiento de las URLs viejas apuntándolas a la
# categoría equivalente del catálogo nuevo (301 = permanente).
<IfModule mod_alias.c>

  RedirectMatch 301 ^/peluches\.html$                  /catalogo.html?cat=peluches
  RedirectMatch 301 ^/accesorios\.html$                /catalogo.html?cat=accesorios
  RedirectMatch 301 ^/relojes\.html$                   /catalogo.html?cat=relojes
  RedirectMatch 301 ^/juguetes-ninas\.html$            /catalogo.html?cat=juguetes-ninas
  RedirectMatch 301 ^/juguetes-ninos-avengers\.html$   /catalogo.html?cat=juguetes-ninos-avengers
  RedirectMatch 301 ^/bebes-fisher-price\.html$        /catalogo.html?cat=bebes-fisher-price
  RedirectMatch 301 ^/legos\.html$                     /catalogo.html?cat=legos
  RedirectMatch 301 ^/joyas-plata\.html$               /catalogo.html?cat=joyas-plata
  RedirectMatch 301 ^/joyas-lannel\.html$              /catalogo.html?cat=joyas-lannel
  RedirectMatch 301 ^/victoria-secret\.html$           /catalogo.html?cat=victoria-secret
  RedirectMatch 301 ^/autos-motos\.html$               /catalogo.html?cat=autos-motos
  RedirectMatch 301 ^/perfumes-mujer\.html$            /catalogo.html?cat=perfumes-mujer
  RedirectMatch 301 ^/perfumes-boss-bottled\.html$     /catalogo.html?cat=perfumes-boss-bottled
  RedirectMatch 301 ^/implementos-deportivos\.html$    /catalogo.html?cat=implementos-deportivos
  RedirectMatch 301 ^/americanino\.html$               /catalogo.html?cat=americanino
  RedirectMatch 301 ^/americanino-mujer\.html$         /catalogo.html?cat=americanino-mujer
  RedirectMatch 301 ^/chevignon-hombres\.html$         /catalogo.html?marca=Chevignon
  RedirectMatch 301 ^/chevignon-mujer\.html$           /catalogo.html?marca=Chevignon
  RedirectMatch 301 ^/offcorss\.html$                  /catalogo.html?cat=offcorss
  RedirectMatch 301 ^/offcorss-nenas\.html$            /catalogo.html?cat=offcorss-nenas
  RedirectMatch 301 ^/camisas-camisetas-polo\.html$    /catalogo.html?cat=camisas-camisetas-polo
  RedirectMatch 301 ^/jeans-men\.html$                 /catalogo.html?cat=jeans-men
  RedirectMatch 301 ^/ocasiones-especiales\.html$      /catalogo.html?cat=ocasiones-especiales
  RedirectMatch 301 ^/detalles\.html$                  /catalogo.html?cat=detalles
  RedirectMatch 301 ^/empresa\.html$                   /nosotros.html
  RedirectMatch 301 ^/contactos\.html$                 /contacto.html
  RedirectMatch 301 ^/metodos-pagos\.html$             /pagos.html
  RedirectMatch 301 ^/pedido\.html$                    /pagos.html
  RedirectMatch 301 ^/error-404\.html$                 /404.html
  RedirectMatch 301 ^/cambio-revoluciones\.html$       /pagos.html
  RedirectMatch 301 ^/promociones-black-friday\.html$  /catalogo.html
</IfModule>

# --- Compresión --------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Caché del navegador -----------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# --- Seguridad básica --------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

Options -Indexes
